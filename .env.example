# TradingSG configuration. Copy to .env and fill in.
#
#     cp .env.example .env && $EDITOR .env && make db-reset && make dev
#
# .env is gitignored. Nothing in here belongs in source, and nothing in here
# belongs in a chat transcript either. build/check-scripts.sh fails CI if a
# credential is found hard-coded anywhere in the repository.

# ── Required for anything to run ───────────────────────────────────────────────

# Where the database lives. The default is a local SQLite file, which needs no
# daemon and is what `make ci` and the test suite use.
#
# For PostgreSQL — which is what any deployment needs, because Vercel's
# filesystem is ephemeral and read-only — run `make db-provider-postgres` first
# and then set this to the connection string. See docs/deployment.md.
DATABASE_URL="file:./tradingsg.db"

# Absolute base URL, used to build the links inside emails. Getting this wrong
# sends everyone a "view my portfolio" button pointing at localhost.
APP_URL="http://localhost:3000"

# Appears on the landing page, in the page title and in every email subject.
COMPANY_NAME="Acme Corp"

# ── Market data ────────────────────────────────────────────────────────────────

# mock    — a deterministic synthetic market. No key, works offline, and it is
#           what generates the weeks of history the demo data needs.
# finnhub — real quotes. Requires FINNHUB_API_KEY below.
MARKET_DATA_PROVIDER="mock"

# Seeds the synthetic generator. The same seed reproduces the same market, so a
# reseed does not silently reshuffle the demo leaderboard. 42 was chosen by
# measuring the six-week outcome across candidates: it gives a mixed market with
# real losers, rather than one where everybody looks like a genius.
MOCK_MARKET_SEED="42"

# Free key from https://finnhub.io/register. Only read when
# MARKET_DATA_PROVIDER=finnhub; with that set and this empty the app refuses to
# start rather than showing every stock at zero.
# FINNHUB_API_KEY=

# ── Email ──────────────────────────────────────────────────────────────────────

# console — writes rendered HTML to EMAIL_OUTBOX_DIR so reports can be opened in
#           a browser and reviewed. No credentials, nothing leaves the machine.
# smtp    — real delivery through SMTP_*.
# resend  — real delivery through RESEND_API_KEY.
EMAIL_PROVIDER="console"

# The From: header. With a real provider this address must be on a domain you
# have verified, or every message is silently dropped as spam.
EMAIL_FROM="TradingSG <no-reply@example.com>"

# Where the console provider writes. Gitignored.
EMAIL_OUTBOX_DIR=".mail"

# All four are required together when EMAIL_PROVIDER=smtp.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# From https://resend.com/api-keys. Required when EMAIL_PROVIDER=resend.
# RESEND_API_KEY=

# ── Scheduled jobs ─────────────────────────────────────────────────────────────

# Bearer token the /api/cron/* routes require, which is how Vercel Cron triggers
# a job in production. Leave it unset locally and run jobs with `make job` or
# `make worker` instead — without it those routes return 404 rather than
# standing open.
#   openssl rand -base64 32
# CRON_SECRET=
